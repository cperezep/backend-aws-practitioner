# Basic authorizer credentials
USER_GITHUB=your_github_username
USER_PASSWORD=your_password

# SNS email subscriptions
# Primary: receives ALL product-created notifications
NOTIFY_ADMIN_EMAIL=admin@example.com

# Secondary: receives only high-value product notifications (price >= threshold)
NOTIFY_OPS_EMAIL=ops@example.com

# Price threshold for the ops (filtered) SNS subscription (default: 100)
NOTIFY_HIGH_VALUE_PRICE_THRESHOLD=100
